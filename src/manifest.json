{
  "manifestVersion": 5,
  "id": "com.sliceman.plugin",
  "name": "Sliceman",
  "version": "0.0.9",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [
        1
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon@2x.png",
      "scale": [
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light"
      ],
      "species": [
        "generic"
      ]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "sliceman.panel",
      "label": {
        "default": "Sliceman"
      },
      "icons": [
        {
          "width": 24,
          "height": 24,
          "path": "icons/icon.png",
          "scale": [
            1
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "lightest",
            "light"
          ],
          "species": [
            "generic"
          ]
        },
        {
          "width": 48,
          "height": 48,
          "path": "icons/icon@2x.png",
          "scale": [
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "lightest",
            "light"
          ],
          "species": [
            "generic"
          ]
        }
      ],
      "minimumSize": {
        "width": 350,
        "height": 120
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 640
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
