{
  "manifestVersion": 5,
  "id": "com.sliceman.plugin",
  "name": "Sliceman",
  "version": "0.0.1",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "23.3.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "sliceman.panel",
      "label": { "default": "Sliceman" },
      "minimumSize": { "width": 200, "height": 120 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 260, "height": 420 },
      "preferredFloatingSize": { "width": 260, "height": 420 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
