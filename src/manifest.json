{
  "manifestVersion": 5,
  "id": "com.sliceman.plugin",
  "name": "Sliceman",
  "version": "0.0.15",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/pluginIcon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "light", "lightest"],
      "species": ["generic"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "sliceman.panel",
      "label": {
        "default": "Sliceman"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panelIcon-dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark"],
          "species": ["generic"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panelIcon-light.png",
          "scale": [1, 2],
          "theme": ["light", "lightest"],
          "species": ["generic"]
        }
      ],
      "minimumSize": {
        "width": 300,
        "height": 120
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 640
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
